{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "types":["node"],
    "rootDir": "server",
    "outDir": "dist",
    "declarationDir": "types",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types"
  ]
}

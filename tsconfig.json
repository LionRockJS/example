{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "types":["node"],
    "outDir": "dist",
    "declarationDir": "types",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.mts",
    "application/**/*.ts",
    "application/**/*.mts",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "types"
  ]
}

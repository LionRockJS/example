/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "example-admin",
	"main": "server/Server.ts",
	"compatibility_date": "2026-05-08",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Cross-domain session: set CORS_ORIGINS to allow the session worker origin.
		// e.g. "https://example-session.workers.dev" or "*" for dev
		"CORS_ORIGINS": ""
	},
	"rules": [
    {
      "type": "ESModule",
      "globs": [
				"application/**/*.ts",
				"application/**/*.mts",
				"*.json"
			],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
				"*.liquid"
			],
      "fallthrough": true
    }
  ],
	"r2_buckets": [
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "lionrockjs-form-uploads"
    }
  ],
	"d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "admin",
      // Replace this with the database_id printed by `npm run d1:create`
      // or shown by `npm run d1:list` in your Cloudflare account.
      "database_id": "0913de69-6114-48fe-afba-14a12d539d38",
      "preview_database_id": "0913de69-6114-48fe-afba-14a12d539d38"
    }
  ]
}

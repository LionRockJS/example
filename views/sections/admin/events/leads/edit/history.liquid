<div class="panel-space">
    <div class="font-bold text-primary mb-4 text-center">Activity</div>

    <!-- Sent eDMs Section -->
    {% if sent_edms != blank and sent_edms.size > 0 %}
    <div class="mb-8">
      <div class="font-semibold text-gray-700 mb-2 text-center">Sent eDMs</div>
      <div class="grid grid-cols-1 md:grid-cols-2 max-w-[600px] mx-auto">
        {% for edm in sent_edms %}
          <div class="border-e border-gray-300 text-end px-4 pt-2 text-gray-500 text-xs flex items-start justify-end">
            {{ edm.sent_at | date: "%Y-%m-%d %H:%M" | default: "N/A" }}
          </div>
          <div class="px-4 py-1">
            <a href="//{{ edm_base }}/rsvp/{{ edm.event_slug }}/{{ edm.edm_id }}/{{ edm.view_id }}/{{ edm.sign }}" 
               target="_blank" 
               class="text-primary hover:underline">
              <i class="fa-light fa-envelope"></i> {{ edm.edm_name }}
            </a>
            {% if edm.subject != blank %}
              <div class="text-xs text-gray-500">{{ edm.subject }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    
    <!-- Response Activity -->
    <div class="grid grid-cols-1 md:grid-cols-2 max-w-[600px] mx-auto">
      {% assign responses = tokens.response | reverse %}
      {% for response in responses %}
        {% if response.status != blank %}
          <div class="border-e border-gray-300 text-end px-4 pt-2 text-gray-500 text-xs flex items-start justify-end">{{ response.date | date: "%Y-%m-%d %H:%M" | default : response.date }}</div>
          <div class="px-4 py-1"><span class="font-bold">{{ response.status | capitalize }}</span> <span class="text-xs text-gray-500">({{ response.message }})</span></div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% if block_data != blank %}
  {% for travel in block_data %}
    <div class="mt-4">
      <div class="font-bold text-primary border-b border-b-gray-300 pb-2">
        <i class="fa-light fa-plane-departure"></i> Travel & Hotel Information
      </div>
      
      {% if travel.departure-city != blank or travel.departure-date != blank %}
        <div class="mt-3">
          <div class="font-medium text-gray-700">Departure Information:</div>
          <div class="grid grid-cols-2 gap-4 mt-1">
            {% if travel.departure-city != blank %}
              <div><span class="font-medium">City:</span> {{ travel.departure-city }}</div>
            {% endif %}
            {% if travel.departure-date != blank %}
              <div><span class="font-medium">Date:</span> {{ travel.departure-date }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      
      {% if travel.message != blank %}
        <div class="mt-3">
          <div class="font-medium text-gray-700">Additional Message:</div>
          <div class="mt-1 text-gray-600">{{ travel.message }}</div>
        </div>
      {% endif %}
      
      {% assign has_flight = false %}
      {% for item in travel %}
        {% if item[0] contains 'flight-' %}
          {% assign has_flight = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if has_flight %}
        <div class="mt-3">
          <div class="font-medium text-gray-700">Flight Details:</div>
          <div class="grid grid-cols-2 gap-4 mt-1">
            {% for item in travel %}
              {% assign key = item[0] %}
              {% assign value = item[1] %}
              {% if key contains 'flight-' and value != blank %}
                <div><span class="font-medium">{{ key | replace: 'flight-', '' | capitalize }}:</span> {{ value }}</div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
      
      {% assign has_hotel = false %}
      {% for item in travel %}
        {% if item[0] contains 'hotel-' or item[0] contains 'check-' %}
          {% assign has_hotel = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% if has_hotel %}
        <div class="mt-3">
          <div class="font-medium text-gray-700">Hotel Information:</div>
          <div class="mt-1">
            {% if travel.hotel-name != blank %}
              <div><span class="font-medium">Hotel:</span> {{ travel.hotel-name }}</div>
            {% endif %}
            <div class="grid grid-cols-2 gap-4 mt-1">
              {% if travel.check-in-date != blank %}
                <div><span class="font-medium">Check-in Date:</span> {{ travel.check-in-date }}</div>
              {% endif %}
              {% if travel.check-out-date != blank %}
                <div><span class="font-medium">Check-out Date:</span> {{ travel.check-out-date }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  {% endfor %}
{% endif %}

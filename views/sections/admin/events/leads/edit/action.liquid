<div class="flex panel-space items-center justify-end pt-4 border-t border-gray-200">
    <a class="button-secondary block px-4 text-red-800" href="/admin/rsvp/{{ rsvp_id }}/delete/{{ item.id }}">Delete</a>
  
    {% if available_mail_lists.size > 0 %}
    <div class="flex items-center me-4">
      <form id="move-form" action="/admin/rsvp/{{ rsvp_id }}/move/{{ item.id }}" method="POST" class="flex items-center">
        <select name="target_mail_list" id="target_mail_list" class="rounded-md border border-gray-300 px-3 py-2 text-sm me-2 min-w-48" required>
          <option value="">Select mail list...</option>
          {% for mail_list in available_mail_lists %}
            <option value="{{ mail_list.id }}">{{ mail_list.name }}</option>
          {% endfor %}
        </select>
        <button type="submit" 
                class="transition duration-500 rounded-lg px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus-visible:outline-offset-2 focus-visible:outline-blue-600 cursor-pointer"
                onclick="return confirm('Are you sure you want to move this guest to the selected mail list? This action cannot be undone.')">
          <i class="fas fa-exchange-alt me-1"></i>Move
        </button>
      </form>
    </div>
    {% endif %}
  
    <a class="button-secondary block me-4 px-4" href="/admin/rsvp/{{ rsvp_id }}">Back</a>
  
    <div>
      <button form="main-form" type="submit"
              class="transition duration-500 w-full rounded-lg px-6 py-2 uppercase text-base leading-8 font-sans text-white bg-primary hover:bg-gray-900 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
      >Save</button>
    </div>
  </div>
<!--
    selector:selector,
    page_id: page_id,

    tokens: tokens,
    block_index: block._key,
    placeholder:placeholder[placeholder_key],
    blueprint: blocks_blueprint[tokens._type],
    inputs: inputs,
    form: form
-->
{% liquid
    assign attributes = blueprint.attributes
    assign fields = blueprint.fields
    assign items = blueprint.items
%}
<div>
    <label for="toggle-{{ prefix }}"
           class="mb-2 uppercase text-primary cursor-pointer select-none flex items-center gap-2"
    ><i class="fa-regular fa-plate-utensils"></i>Meal preference</label>
    <div class="text-sm text-gray-500 mb-4"></div>

    <div>
        <div class="w-full">
            <!-- title -->
            <div class="mb-4 relative">
                {% assign key = "title" %}
                {% assign type = "." %}
                {% assign name = prefix | append: type | append: key %}
                {% assign value = tokens[key] %}

                <label for="{{ name | md5 }}" class="absolute text-xs bg-gray-50 -top-2 left-2 text-gray-500 z-10 flex items-center gap-1">
                    <span>Title</span>
                </label>
                <input type="text"
                       form="{{ form }}"
                       id="{{ name | md5 }}"
                       name="{{ name }}"
                       value="{{ value | default : "Meal preference" }}"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent placeholder:text-gray-400"
                       placeholder="Meal preference"
                />
            </div>


            <!--body-->
            <div class="mb-4 relative">
                {% assign key = "body" %}
                {% assign type = "." %}
                {% assign name = prefix | append: type | append: key %}
                {% assign value = tokens[key] %}
                <label for="field-{{ name }}" class="absolute text-xs bg-gray-50 -top-2 left-2 text-gray-500 z-10 flex items-center gap-1">
                    <i class="fa-solid fa-align-left"></i>
                    <span>Body</span>
                </label>

                <div class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent placeholder:text-gray-400">
                {% render "pagefield/richtext/md",
                    selector: name,
                    label: "Body",
                    value: value,
                    placeholder: "instructions for guest to provide meal preferences",
                    form: form
                %}
                </div>
            </div>
        </div>

        <!-- items -->
        {% for item in items %}
            {%- liquid
                assign item_name = item.name
                assign item_label = item.name | capitalize
                assign default_items = " " |  split: ","
                assign page_items = tokens[item_name] | default: default_items
                assign page_items = page_items | sort : "_weight"
                assign key = "#" | append: block_index | append: item_name | md5
            -%}
            <div class="relative">
                <input type="checkbox" class="peer hidden" data-state-store="true" checked="checked" id="toggle-{{ key }}">
                <label class="peer-checked:hidden inline-block cursor-pointer select-none text-gray-400 px-4 mt-4 mb-2 min-w-[20%] text-center bg-gray-200 rounded-full" for="toggle-{{ key }}">{{ item_label }}<i class="far fa-copy ms-2"></i></label>

                <div class="hidden peer-checked:block">
                    <!-- item name -->

                    <div class="inline-flex justify-between min-w-[20%] pt-4 pb-2">
                        <label for="toggle-{{ key }}" class="text-ellipsis block font-bold cursor-pointer select-none hover:text-highlight ">{{ item_name | capitalize }}</label>
                        <input type="text" pattern="\d+" name="count:{{ block_index }}|{{ item_name }}" value="1"
                               form="{{ form | default: "main-form" }}"
                               class="mx-2 w-8 text-center bg-white text-black rounded-full py-0.5 text-sm border border-gray-300"
                        >
                        <button type="submit"
                                form="{{ form | default: "main-form" }}"
                                class="button-add" name="action" value="block-item-add:{{ block_index }}|{{ item_name }}"><i class="fa-light fa-circle-plus"></i></button>
                    </div>

                    <div class="w-full">
                        {% for page_item in page_items %}
                            {% capture item_prefix %}#{{ block_index }}.{{ item_name }}[{{ page_item._key }}]{% endcapture %}

                            <div class="flex flex-row mb-3 relative">
                                <div class="absolute -ms-2">
                                    {% render "page/edit/item/weight", prefix: item_prefix, weight: page_item._weight, form: form %}
                                </div>

                                <div class="ps-10 w-full">
                                    {% assign placeholder_block_item = placeholder[item_name][page_item._key] %}

                                    {%- liquid
                                        render 'page/edit/scaffold-input', items: item.attributes, key: "@", prefix: item_prefix, inputs: inputs, placeholders: placeholder_block_item, values: page_item, icon: 'gear', form: form
                                        render 'page/edit/scaffold-input', items: item.fields, key: ".", prefix: item_prefix, inputs: inputs, placeholders: placeholder_block_item, values: page_item, icon: 'gear', form: form
                                    -%}
                                </div>

                                <div class="pt-1.5 w-4 me-2">
                                    {% if forloop.length > 1 %}
                                        <button type="submit" name="action" value="block-item-delete:{{ block_index }}|{{ item_name }}|{{ page_item._key }}" form="main-form"><i class="fal fa-times"></i></button>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
        <!-- end items -->

        <div class="group">
            <div>Allow guest leave message?</div>
            <!-- radio buttons for yes/no -->
            <div>
                <label class="inline-flex items-center me-4">
                    <input type="radio" name="{{ prefix }}@allow_message" value="yes" form="main-form" {% if tokens.allow_message == "yes" %}checked{% endif %}>
                    <span class="ml-2">Yes</span>
                </label>
                <label class="inline-flex items-center">
                    <input type="radio" name="{{ prefix }}@allow_message" value="no" form="main-form" {% if tokens.allow_message != "yes" %}checked{% endif %}>
                    <span class="ml-2">No</span>
                </label>
            </div>
            <div class="my-4 relative group-has-[input[value='no']:checked]:hidden">
                {% assign key = "message_placeholder" %}
                {% assign type = "." %}
                {% assign name = prefix | append: type | append: key %}
                {% assign value = tokens[key] %}

                <label for="{{ name | md5 }}" class="absolute text-xs bg-gray-50 -top-2 left-2 text-gray-500 z-10 flex items-center gap-1">
                    <span>Message text box placeholder</span>
                </label>
                <input type="text"
                       form="main-form"
                       id="{{ name | md5 }}"
                       name="{{ name }}"
                       value="{{ value }}"
                       placeholder="Please let us know if you have any special dietary requirements."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                />
            </div>
        </div>
    </div>
</div>
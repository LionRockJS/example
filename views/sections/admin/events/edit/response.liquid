{% assign guests_count = responses | size %}
<div class="panel-space border-t border-primary py-8">
  <div class="mb-4">
    <div class="text-2xl text-primary font-bold"> <i class="fa-light fa-message-dots"></i> Guest Responses</div>
    <div class="text-md text-gray-700"></div>
  </div>
  <div class="mb-4">
      {% if guests_count > 0 %}
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
          <tr class="text-left text-gray-900">
            <td class="pe-3">Date</td>
            <th class="pe-3">Name / Contact</th>
            <th class="text-end">Response</th>
            {% if total_checked_in_count > 0 %}<th class="ps-3 text-nowrap text-right">Checked-in</th>{% endif %}
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">

          {% for guest in responses %}
            <tr>
              <td class="text-nowrap pe-2">
                {% assign response = guest.print.tokens.response | find: "message", "guest response" %}
                {% assign response_date = response.date | default: guest.updated_at %}
                <div>{{ response_date | replace: "T", " " | replace: "Z", "" | to_time | date: "%Y-%m-%d" }}</div>
                <div class="text-xs">{{ response_date | replace: "T", " " | replace: "Z", "" | to_time | date: "%H:%M" }}</div>
              </td>
              <td class="text-nowrap pe-3 max-w-[20rem]">
                <a class="block" href="/admin/rsvp/{{ guest.list_id }}/edit/{{ guest.id }}">
                  <div class="underline w-full text-ellipsis overflow-hidden">
                    {{ guest.name }}
                  </div>
                  <div class="text-xs">{{ guest.contact }}</div>
                </a>
              </td>
              <td class="overflow-hidden text-ellipsis text-nowrap text-end response-state-{{ guest.print.tokens.status | downcase | replace: " ", "-" }}">{{ guest.print.tokens.status | capitalize }}</td>
              {% if total_checked_in_count > 0 %}<td class="ps-3 text-right">{{ guest.print.tokens.checked_in | default: "-" }}</td>{% endif %}
            </tr>
          {% endfor %}
          </tbody>
        </table>
        <p class="text-gray-500 mt-3 text-end">Total {{ responses | size }} responses.</p>
      {% else %}
        <p class="text-gray-500">No responses yet.</p>
      {% endif %}
    </div>
</div>
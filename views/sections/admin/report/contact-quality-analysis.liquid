<div class="panel-space">
  <!-- Overall Quality Score -->
  <div>
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-3xl font-bold mb-2">Contact Quality Report</h2>
      </div>
    </div>
  </div>

  <!-- Summary Statistics -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
      <h3 class="text-gray-500 text-sm font-medium mb-2">Total Contacts</h3>
      <p class="text-3xl font-bold text-gray-900">{{ analysis.total }}</p>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
      <h3 class="text-gray-500 text-sm font-medium mb-2">High Quality</h3>
      <p class="text-3xl font-bold text-green-600">{{ analysis.highQuality }}</p>
      <p class="text-sm text-gray-500 mt-1">Tiers 1-2 ({{ analysis.percentages.highQuality }}%)</p>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
      <h3 class="text-gray-500 text-sm font-medium mb-2">Medium Quality</h3>
      <p class="text-3xl font-bold text-yellow-600">{{ analysis.mediumQuality }}</p>
      <p class="text-sm text-gray-500 mt-1">Tier 3 ({{ analysis.percentages.mediumQuality }}%)</p>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-red-500">
      <h3 class="text-gray-500 text-sm font-medium mb-2">Low Quality</h3>
      <p class="text-3xl font-bold text-red-600">{{ analysis.lowQuality }}</p>
      <p class="text-sm text-gray-500 mt-1">Tiers 4-5 ({{ analysis.percentages.lowQuality }}%)</p>
    </div>
  </div>

  <!-- Tier Distribution -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900">Tier Distribution</h2>
      <p class="text-gray-600 mt-1">Contacts grouped by available contact methods</p>
    </div>
    <div class="p-6">
      <div class="space-y-6">
        <!-- Tier 1 -->
        <div>
          <div class="flex justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">
              🥇 Tier 1 (Phone + Email + Social Media)
            </span>
            <span class="text-sm font-medium text-gray-900">
              {{ analysis.tierCounts[1] }} ({{ analysis.percentages.tier1 }}%)
            </span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-green-600 h-3 rounded-full transition-all duration-500" style="width: {{ analysis.percentages.tier1 }}%"></div>
          </div>
        </div>

        <!-- Tier 2 -->
        <div>
          <div class="flex justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">
              🥈 Tier 2 (2 out of 3 contact methods)
            </span>
            <span class="text-sm font-medium text-gray-900">
              {{ analysis.tierCounts[2] }} ({{ analysis.percentages.tier2 }}%)
            </span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-blue-600 h-3 rounded-full transition-all duration-500" style="width: {{ analysis.percentages.tier2 }}%"></div>
          </div>
        </div>

        <!-- Tier 3 -->
        <div>
          <div class="flex justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">
              🥉 Tier 3 (1 out of 3 contact methods)
            </span>
            <span class="text-sm font-medium text-gray-900">
              {{ analysis.tierCounts[3] }} ({{ analysis.percentages.tier3 }}%)
            </span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-yellow-600 h-3 rounded-full transition-all duration-500" style="width: {{ analysis.percentages.tier3 }}%"></div>
          </div>
        </div>

        <!-- Tier 4 -->
        <div>
          <div class="flex justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">
              📞 Tier 4 (General contact info only)
            </span>
            <span class="text-sm font-medium text-gray-900">
              {{ analysis.tierCounts[4] }} ({{ analysis.percentages.tier4 }}%)
            </span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-orange-600 h-3 rounded-full transition-all duration-500" style="width: {{ analysis.percentages.tier4 }}%"></div>
          </div>
        </div>

        <!-- Tier 5 -->
        <div>
          <div class="flex justify-between mb-2">
            <span class="text-sm font-medium text-gray-700">
              ❌ Tier 5 (No contact information)
            </span>
            <span class="text-sm font-medium text-gray-900">
              {{ analysis.tierCounts[5] }} ({{ analysis.percentages.tier5 }}%)
            </span>
          </div>
          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-red-600 h-3 rounded-full transition-all duration-500" style="width: {{ analysis.percentages.tier5 }}%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sample Contacts by Tier -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900">Sample Contacts by Tier</h2>
      <p class="text-gray-600 mt-1">Example contacts for each quality tier</p>
    </div>
    <div class="p-6">
      {% for tier in (1..5) %}
        {% assign tier_key = tier | prepend: '' %}
        {% assign samples = analysis.tierSamples[tier_key] %}
        {% if samples.size > 0 %}
          <div class="mb-8 last:mb-0">
            <h3 class="text-lg font-bold text-gray-900 mb-4">
              {% if tier == 1 %}🥇 Tier 1 - Excellent
              {% elsif tier == 2 %}🥈 Tier 2 - Good
              {% elsif tier == 3 %}🥉 Tier 3 - Fair
              {% elsif tier == 4 %}📞 Tier 4 - Limited
              {% else %}❌ Tier 5 - None
              {% endif %}
            </h3>
            <div class="space-y-4">
              {% for sample in samples limit:5 %}
                <div class="border-l-4 {% if tier == 1 %}border-green-500 bg-green-50{% elsif tier == 2 %}border-blue-500 bg-blue-50{% elsif tier == 3 %}border-yellow-500 bg-yellow-50{% elsif tier == 4 %}border-orange-500 bg-orange-50{% else %}border-red-500 bg-red-50{% endif %} p-4">
                  <div class="font-medium text-gray-900 mb-2">
                    <a href="/admin/contacts/{{ sample.id }}" class="text-blue-600 hover:text-blue-800 hover:underline">
                      {{ sample.name }} (ID: {{ sample.id }})
                    </a>
                  </div>
                  
                  {% if sample.contactTypeTags.size > 0 %}
                    <div class="text-sm text-gray-600 mb-2">
                      🏷️ Type: {{ sample.contactTypeTags | join: ", " }}
                    </div>
                  {% endif %}
                  
                  {% if sample.phoneNumbers.size > 0 %}
                    <div class="text-sm text-gray-600">
                      📱 Phone: {{ sample.phoneNumbers | join: ", " }}
                    </div>
                  {% endif %}
                  
                  {% if sample.emailAddresses.size > 0 %}
                    <div class="text-sm text-gray-600">
                      📧 Email: {{ sample.emailAddresses | join: ", " }}
                    </div>
                  {% endif %}
                  
                  {% if sample.socialMediaList.size > 0 %}
                    <div class="text-sm text-gray-600">
                      📲 Social: {{ sample.socialMediaList | join: ", " }}
                    </div>
                  {% endif %}
                  
                  {% if sample.generalContact.size > 0 %}
                    <div class="text-sm text-gray-600">
                      🏢 General: {{ sample.generalContact | join: ", " }}
                    </div>
                  {% endif %}
                  
                  {% if sample.hasPhone == false and sample.hasEmail == false and sample.hasSocialMedia == false and sample.hasGeneralOnly == false %}
                    <div class="text-sm text-red-600">
                      ❌ No contact information
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Contact Type Distribution for Low Quality Contacts -->
  {% if analysis.tierCounts[4] > 0 or analysis.tierCounts[5] > 0 %}
    <div class="bg-white rounded-lg shadow mb-8">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-2xl font-bold text-gray-900">Contact Type Distribution (Tiers 4 & 5)</h2>
        <p class="text-gray-600 mt-1">Breakdown of low-quality contacts by contact type</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Tier 4 Contact Types -->
          {% if analysis.tierCounts[4] > 0 %}
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                📞 Tier 4 ({{ analysis.tierCounts[4] }} contacts)
              </h3>
              {% if analysis.tier4ContactTypes.size > 0 %}
                <div class="space-y-2">
                  {% for item in analysis.tier4ContactTypes %}
                    <div class="flex justify-between items-center p-3 bg-orange-50 rounded-lg">
                      <span class="font-medium text-gray-900">{{ item.type }}</span>
                      <span class="text-sm bg-orange-100 text-orange-800 px-3 py-1 rounded-full">
                        {{ item.count }} ({{ item.percentage }}%)
                      </span>
                    </div>
                  {% endfor %}
                  {% if analysis.tier4NoType > 0 %}
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                      <span class="font-medium text-gray-600">[No Contact Type]</span>
                      <span class="text-sm bg-gray-200 text-gray-700 px-3 py-1 rounded-full">
                        {{ analysis.tier4NoType }} ({{ analysis.tier4NoType | times: 100 | divided_by: analysis.tierCounts[4] }}%)
                      </span>
                    </div>
                  {% endif %}
                </div>
              {% else %}
                <p class="text-gray-500 italic">No contacts with Contact Type tags</p>
              {% endif %}
            </div>
          {% endif %}

          <!-- Tier 5 Contact Types -->
          {% if analysis.tierCounts[5] > 0 %}
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                ❌ Tier 5 ({{ analysis.tierCounts[5] }} contacts)
              </h3>
              {% if analysis.tier5ContactTypes.size > 0 %}
                <div class="space-y-2">
                  {% for item in analysis.tier5ContactTypes %}
                    <div class="flex justify-between items-center p-3 bg-red-50 rounded-lg">
                      <span class="font-medium text-gray-900">{{ item.type }}</span>
                      <span class="text-sm bg-red-100 text-red-800 px-3 py-1 rounded-full">
                        {{ item.count }} ({{ item.percentage }}%)
                      </span>
                    </div>
                  {% endfor %}
                  {% if analysis.tier5NoType > 0 %}
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                      <span class="font-medium text-gray-600">[No Contact Type]</span>
                      <span class="text-sm bg-gray-200 text-gray-700 px-3 py-1 rounded-full">
                        {{ analysis.tier5NoType }} ({{ analysis.tier5NoType | times: 100 | divided_by: analysis.tierCounts[5] }}%)
                      </span>
                    </div>
                  {% endif %}
                </div>
              {% else %}
                <p class="text-gray-500 italic">No contacts with Contact Type tags</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Duplicate Contacts -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Duplicate Emails -->
    <div class="bg-white rounded-lg shadow">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Duplicate Email Addresses</h2>
        <p class="text-sm text-gray-600 mt-1">{{ analysis.duplicateEmails.size }} duplicate emails found</p>
      </div>
      <div class="p-6 max-h-96 overflow-y-auto">
        {% if analysis.duplicateEmails.size > 0 %}
          <div class="space-y-4">
            {% for dup in analysis.duplicateEmails %}
              <div class="border-l-4 border-red-500 pl-4 py-2 bg-red-50">
                <div class="font-medium text-gray-900 mb-2">{{ dup.email }}</div>
                <div class="text-sm text-gray-600">{{ dup.count }} contacts:</div>
                <ul class="mt-2 space-y-1">
                  {% for contact in dup.contacts %}
                    <li class="text-sm">
                      <a href="/admin/contacts/{{ contact.id }}" class="text-blue-600 hover:text-blue-800 hover:underline">
                        {{ contact.name }} (ID: {{ contact.id }})
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-gray-500 italic">No duplicate emails found</p>
        {% endif %}
      </div>
    </div>

    <!-- Duplicate Phones -->
    <div class="bg-white rounded-lg shadow">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Duplicate Phone Numbers</h2>
        <p class="text-sm text-gray-600 mt-1">{{ analysis.duplicatePhones.size }} duplicate phones found</p>
      </div>
      <div class="p-6 max-h-96 overflow-y-auto">
        {% if analysis.duplicatePhones.size > 0 %}
          <div class="space-y-4">
            {% for dup in analysis.duplicatePhones %}
              <div class="border-l-4 border-orange-500 pl-4 py-2 bg-orange-50">
                <div class="font-medium text-gray-900 mb-2">{{ dup.phone }}</div>
                <div class="text-sm text-gray-600">{{ dup.count }} contacts:</div>
                <ul class="mt-2 space-y-1">
                  {% for contact in dup.contacts %}
                    <li class="text-sm">
                      <a href="/admin/contacts/{{ contact.id }}" class="text-blue-600 hover:text-blue-800 hover:underline">
                        {{ contact.name }} (ID: {{ contact.id }})
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-gray-500 italic">No duplicate phone numbers found</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Top Organizations & Industries -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Top Organizations -->
    <div class="bg-white rounded-lg shadow">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Top Organizations</h2>
        <p class="text-sm text-gray-600 mt-1">Most represented organizations</p>
      </div>
      <div class="p-6 max-h-96 overflow-y-auto">
        {% if analysis.topOrganizations.size > 0 %}
          <div class="space-y-2">
            {% for org in analysis.topOrganizations %}
              <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
                <span class="font-medium text-gray-900">{{ org.name }}</span>
                <span class="text-sm bg-blue-100 text-blue-800 px-3 py-1 rounded-full">{{ org.count }}</span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-gray-500 italic">No organization data available</p>
        {% endif %}
      </div>
    </div>

    <!-- Top Industries -->
    <div class="bg-white rounded-lg shadow">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Top Industries</h2>
        <p class="text-sm text-gray-600 mt-1">Industry distribution</p>
      </div>
      <div class="p-6 max-h-96 overflow-y-auto">
        {% if analysis.topIndustries.size > 0 %}
          <div class="space-y-2">
            {% for industry in analysis.topIndustries %}
              <div class="flex justify-between items-center p-3 bg-purple-50 rounded-lg">
                <span class="font-medium text-gray-900">{{ industry.name }}</span>
                <span class="text-sm bg-purple-100 text-purple-800 px-3 py-1 rounded-full">{{ industry.count }}</span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="text-gray-500 italic">No industry data available</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex gap-4">
    <a href="/admin/contacts" 
       class="inline-block transition duration-500 rounded-lg px-6 py-3 uppercase text-base font-sans text-white bg-blue-600 hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
      View All Contacts
    </a>
    <button onclick="window.print()" 
            class="inline-block transition duration-500 rounded-lg px-6 py-3 uppercase text-base font-sans text-gray-700 bg-gray-200 hover:bg-gray-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300">
      Print Report
    </button>
  </div>
</div>

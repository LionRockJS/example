<div class="panel-space">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">User Usage Report</h1>
      <p class="text-sm text-gray-600 mt-1">
        {% if startDate %}From: {{ startDate }}{% endif %}
        {% if startDate and endDate %} | {% endif %}
        {% if endDate %}To: {{ endDate }}{% endif %}
        {% if isDefaultRange %} <span class="text-blue-600">(Default: Last 30 Days)</span>{% endif %}
      </p>
    </div>
    
    <div class="flex gap-2">
      <button onclick="document.getElementById('dateFilterForm').classList.toggle('hidden')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
        📅 {% if isDefaultRange %}Change{% else %}Set{% endif %} Date Range
      </button>
    </div>
  </div>

  <!-- Date Filter Form -->
  <div id="dateFilterForm" class="hidden mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
    <form method="GET" action="/admin/reports/user-usage" class="flex gap-4 items-end">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label>
        <input type="date" name="start" value="{{ startDate }}" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">End Date</label>
        <input type="date" name="end" value="{{ endDate }}" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
      </div>
      <button type="submit" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
        Generate Report
      </button>
    </form>
  </div>

  <!-- Report Content -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="font-mono text-sm whitespace-pre-wrap overflow-x-auto">
      {% assign lines = reportContent | split: "
" %}
      {% for line in lines %}
        {% if line contains "===" or line contains "📈" or line contains "📋" %}
          <div class="font-bold text-blue-700 mt-4 mb-2">{{ line | escape }}</div>
        {% elsif line contains "👤 User:" %}
          <div class="font-bold text-green-700 mt-6 mb-2 text-base">{{ line | escape }}</div>
        {% elsif line contains "-----" %}
          <div class="border-b border-gray-300 my-2"></div>
        {% elsif line contains "📝" or line contains "✏️" or line contains "🗑️" or line contains "📊" or line contains "🔐" %}
          <div class="font-semibold text-gray-800 mt-3 mb-1">{{ line | escape }}</div>
        {% elsif line contains "•" %}
          <div class="text-gray-700 ml-4">{{ line | escape }}</div>
        {% elsif line contains "✅" %}
          <div class="text-green-600 font-medium mt-4">{{ line | escape }}</div>
        {% else %}
          <div class="text-gray-600">{{ line | escape }}</div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Quick Links -->
  <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
    <h3 class="font-semibold text-blue-900 mb-2">💡 Quick Date Ranges</h3>
    <div class="flex flex-wrap gap-2">
      <a href="?start={{ 'now' | date: '%Y-%m-%d' | date: '%s' | minus: 604800 | date: '%Y-%m-%d' }}&end={{ 'now' | date: '%Y-%m-%d' }}" 
         class="px-3 py-1 bg-white hover:bg-blue-100 text-blue-700 rounded border border-blue-300 text-sm transition-colors">
        Last 7 Days
      </a>
      <a href="?start={{ 'now' | date: '%Y-%m-%d' | date: '%s' | minus: 2592000 | date: '%Y-%m-%d' }}&end={{ 'now' | date: '%Y-%m-%d' }}" 
         class="px-3 py-1 bg-white hover:bg-blue-100 text-blue-700 rounded border border-blue-300 text-sm transition-colors">
        Last 30 Days
      </a>
      <a href="?start={{ 'now' | date: '%Y-%m-01' }}&end={{ 'now' | date: '%Y-%m-%d' }}" 
         class="px-3 py-1 bg-white hover:bg-blue-100 text-blue-700 rounded border border-blue-300 text-sm transition-colors">
        This Month
      </a>
    </div>
  </div>
</div>

{%- liquid
    assign selector_input = 'input_tag_' | append : tag_group
    assign selector_list = 'tag_' |append: tag_group |append: "_list"
    assign lang = language | default: "mis"
-%}
<div class="page-tag-form my-4" data-page="{{ page_id }}" data-tag-type="{{ tag_group }}">
    <div class="flex flex-row items-center">
        <div class="relative w-full pe-2">
            <input id="{{ tag_group }}_checkbox" type="checkbox" class="peer hidden" data-state-store="true" checked>
            <label for="{{ selector_input }}" class="peer-checked:absolute peer-checked:-top-2 peer-checked:ms-2 inline-block bg-gray-100 px-1 text-xs font-medium text-gray-900">{{ label }}</label>
            <input id="{{ selector_input }}" type="text" class="tag-add-input hidden peer-checked:block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" list="{{ selector_list }}" placeholder="{{ placeholder | default: "Search" }}" data-controller="{{ controller | default: "page" }}"/>
            <datalist id="{{ selector_list }}">
                {% for tag in tag_options %}
                <option value="{{ tag.value }}{% if lang != "mis" and lang != "en" %} ( {{ tag.name }} ) {% endif %}" data-id="{{ tag.id }}" data-value="{{ tag.value }}" data-name="{{ tag.name }}">
                {% endfor %}
            </datalist>
        </div>
    </div>

    <div class="page-tag-list relative mt-2">
        {% for tag in tags %}
            <span role="button" class="page-tag badge bg-black text-white text-xs px-2 py-1 rounded-full" data-id="{{ tag.id }}" data-controller="{{ controller }}">{{ tag.value }} <i class="fas fa-times"></i></span>
        {% endfor %}
    </div>
    {% if page_id contains "new_post/" %}
        <input type="hidden" class="new-page-tag-input" aria-label="tags" name="new_tags[{{ tag_group | downcase | replace: " ", "_" }}]" form="main-form"/>
    {% endif %}
</div>
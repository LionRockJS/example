<div class="mb-8">
  <div>
    <input form="main-form"
           class="block w-full border-0 p-0 font-thin bg-transparent tracking-wide text-6xl focus:border-0 focus:ring-2 focus:ring-inset focus:ring-transparent"
           type="text"
           placeholder="contact name"
           name=":name"
           value="{{ item.name }}"
           required
    >
  </div>
<div>
  <input form="main-form"
         class="block w-full border-0 p-0 font-thin bg-transparent tracking-wide text-sm focus:border-0 focus:ring-2 focus:ring-inset focus:ring-transparent"
         type="text"
         placeholder="slug"
         name=":slug"
         value="{{ item.slug }}"
  >
</div>

</div>
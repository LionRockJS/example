</select>
            </div>
            <!-- Hidden date input -->
            <input
                id="birthday"
                hidden
                class="full-date"
                aria-label="birthday"
                type="date"
                name="@birthday"
                value="{{ birthday_value | escape }}"
                max="2200-12-30"
                form="main-form"
            />
          </div>
        </div>


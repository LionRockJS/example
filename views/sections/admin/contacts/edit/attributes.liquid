<div class="min-h-8 mb-4">
  <!-- checkbox -->
  {% render "ui/toggle/checkbox", toggle_selector: "name1" %}
  <!-- off-label -->
  {% render "ui/toggle/off/label", toggle_selector: "name1", name: "name", icon: "circle-user"%}
  <!-- on-icon_content -->

  <div class="hidden peer-checked:flex border-l-[5px] border-primary hover:border-highlight -translate-x-[3px] me-[24px] md:me-[55px]">
    {% render "ui/toggle/icon", toggle_selector: "name1", icon: "circle-user" %}
    <div>
      <div class="grid grid-cols-3 gap-3">
        <!-- gender -->
        <div class="w-full">
          <label for="gender" class="text-white bg-primary text-xs px-2">Gender</label>
          {% assign gender_value = tokens['gender'] | downcase %}
          <select
              id="gender"
              name="@gender"
              class="text-ellipsis transition-[background] duration-[50000s] block font-sans font-[400] w-full bg-transparent grow p-0 text-gray-800 placeholder:text-gray-400 placeholder:font-[200] focus:outline-none"
              form="main-form"
          >
            <option value="">Please Select</option>
            <option value="m" {% if gender_value == 'm' %}selected{% endif %}>M</option>
            <option value="f" {% if gender_value == 'f' %}selected{% endif %}>F</option>
          </select>
        </div>

        <!-- prefix -->
        <div class="w-full">
          <label for="prefix" class="text-white bg-primary text-xs px-2">Prefix</label>
          {% assign prefix_value = tokens['prefix'] | downcase | replace : ".", '' %}
          <select
              id="prefix"
              name="@prefix"
              class="text-ellipsis transition-[background] duration-[50000s] block font-sans font-[400] w-full bg-transparent grow p-0 text-gray-800 placeholder:text-gray-400 placeholder:font-[200] focus:outline-none"
              form="main-form"
          >
            <option value="">Please Select</option>
            <option value="dr"   {% if prefix_value == 'dr' %}selected{% endif %}>Dr.</option>
            <option value="miss" {% if prefix_value == 'miss' %}selected{% endif %}>Miss.</option>
            <option value="mr"   {% if prefix_value == 'mr' %}selected{% endif %}>Mr.</option>
            <option value="mrs"  {% if prefix_value == 'mrs' %}selected{% endif %}>Mrs.</option>
            <option value="ms"   {% if prefix_value == 'ms' %}selected{% endif %}>Ms.</option>
            <option value="prof" {% if prefix_value == 'prof' %}selected{% endif %}>Prof.</option>
          </select>
        </div>

        <!-- suffix -->
        <div class="w-full">
          <label for="suffix" class="text-white bg-primary text-xs px-2">Suffix</label>
          {% assign suffix_value = tokens['suffix'] %}
          <input type="text" id="suffix" name="@suffix" list="suffixes"
                 value="{{ suffix_value | escape }}"
                 class="text-ellipsis transition-[background] duration-[50000s] block font-sans font-[400] w-full bg-transparent grow p-0 text-gray-800 placeholder:text-gray-400 placeholder:font-[200] focus:outline-none"
                 placeholder="eg. JP"
                 form="main-form"
          >

          <datalist id="suffixes">
            <option value="Jr."></option>
            <option value="Sr."></option>
            <option value="I"></option>
            <option value="II"></option>
            <option value="III"></option>
            <option value="JP"></option>
            <option value="BBS, JP"></option>
            <option value="GBS"></option>
            <option value="GBS, JP"></option>
            <option value="SBS, BBS"></option>
            <option value="GBS, MH, JP"></option>
            <option value="CFA, CAP"></option>
            <option value="MHKIH, RPHM"></option>
            <option value="BBS, MBE, JP"></option>
            <option value="GBM, GBS, JP"></option>
            <option value="BBS, MBA"></option>
          </datalist>
        </div>

        <!-- birthday -->
        <div class="w-full">
          <label for="birthday" class="text-white bg-primary text-xs px-2">Birthday</label>
          {% assign birthday_value = tokens['birthday'] %}
{% liquid
  if birthday_value != blank
    assign birthday_parts = birthday_value | split: "-"
    assign birthday_month = birthday_parts[1] | default: ""
    assign birthday_day = birthday_parts[2] | default: ""
  endif
%}
          <div class="birthday-input-container relative">
            <div class="birthday-input-wrapper">
              <select aria-label="month" class="month-select">
                <option value="">mm</option>
                <option value="01" {% if birthday_month == "01" %}selected{% endif %}>Jan</option>
                <option value="02" {% if birthday_month == "02" %}selected{% endif %}>Feb</option>
                <option value="03" {% if birthday_month == "03" %}selected{% endif %}>Mar</option>
                <option value="04" {% if birthday_month == "04" %}selected{% endif %}>Apr</option>
                <option value="05" {% if birthday_month == "05" %}selected{% endif %}>May</option>
                <option value="06" {% if birthday_month == "06" %}selected{% endif %}>Jun</option>
                <option value="07" {% if birthday_month == "07" %}selected{% endif %}>Jul</option>
                <option value="08" {% if birthday_month == "08" %}selected{% endif %}>Aug</option>
                <option value="09" {% if birthday_month == "09" %}selected{% endif %}>Sep</option>
                <option value="10" {% if birthday_month == "10" %}selected{% endif %}>Oct</option>
                <option value="11" {% if birthday_month == "11" %}selected{% endif %}>Nov</option>
                <option value="12" {% if birthday_month == "12" %}selected{% endif %}>Dec</option>
              </select>
              <select aria-label="day" class="day-select">
<option value="">dd</option>
<option value="01" {% if birthday_day == "01" %}selected{% endif %}>1</option>
<option value="02" {% if birthday_day == "02" %}selected{% endif %}>2</option>
<option value="03" {% if birthday_day == "03" %}selected{% endif %}>3</option>

        {% when 'textarea' %}
          <div class="mb-3">
            <label for="hotel-{{ forloop.index0 }}" class="block mb-1">{{ hotel.label }}{% if hotel.required == "yes" %} *{% endif %}</label>
            <textarea
              id="hotel-{{ forloop.index0 }}"
              name="{{ form_name_key }}"
              placeholder="{{ hotel.description | escape }}"
              {% if form %}form="{{ form }}"{% endif %}
              {% if hotel.required == "yes" %}required{% endif %}
              class="w-full p-2 border border-gray-300 rounded"

<form id="rsvp" action="/en/registration/create" method="post" class="container mb-5">
  <input type="hidden" name=":contact_type" value="email"/>

  <div class="bbr-input-group input-required mb-1">
    <label for="input-name">First Name</label>
    <input type="text" id="input-name" name=":name" class="form-control"/>
  </div>

  <div class="bbr-input-group input-required mb-1">
    <label for="input-last-name">Last Name</label>
    <input type="text" id="input-last-name" name="attributes[last_name]" class="form-control"/>
  </div>

  <div class="bbr-input-group input-required mb-1">
    <label for="input-email">Email</label>
    <input type="email" id="input-email" name=":contact" class="form-control"/>
  </div>

  <div class="bbr-input-group input-required mb-1 align-items-start">
    <label for="input-attending">Region</label>
    <div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="HK" id="region01">
        <label class="form-check-label" for="region01">Hong Kong</label>
      </div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="CN" id="region02">
        <label class="form-check-label" for="region02">Mainland China</label>
      </div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="JP" id="region03">
        <label class="form-check-label" for="region03">Japan</label>
      </div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="TH" id="region04">
        <label class="form-check-label" for="region04">Thailand</label>
      </div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="SG" id="region05">
        <label class="form-check-label" for="region05">Singapore</label>
      </div>
      <div class="form-check">
        <input name="attributes[region][]" class="form-check-input" type="checkbox" value="TW" id="region06">
        <label class="form-check-label" for="region06">Taiwan</label>
      </div>
    </div>
  </div>

  <hr/>

  <div class="small mb-3 text-center">
    Fields marked with <span class="text-danger">*</span> must be filled in.
  </div>

  <div class="text-center">
    <button class="btn btn-primary g-recaptcha"
            data-sitekey="{{ recaptcha_site_key }}"
            data-callback='onSubmit'
            data-action='submit' type="submit">Confirm</button>
  </div>
</form>
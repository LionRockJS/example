<div>{{ count }} contacts found for "{{ search }}"</div>
{% if count > 0 %}
<form id="add-contacts" method="post" action="/admin/rsvp/{{ mail_list_id }}/remove-contacts">
  <input type="hidden" name="search_type" value="contact">
  <table class="w-full divide-y divide-gray-300 text-md">
    <thead>
    <tr>
      <th>
        <input type="checkbox"
               onclick="tableBulkSelect(this)"
               checked
               aria-label="Checkbox Action"
               class="checkbox-bulk-select h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
        >
      </th>
      <th class="py-3.5 text-left font-semibold text-gray-900">Display Name / Company</th>
      <th class="py-3.5 text-left font-semibold text-gray-900">Email</th>
      <th class="py-3.5 text-left font-semibold text-gray-900">CC Emails</th>
      <th class="py-3.5 text-left font-semibold text-gray-900">Phone</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    {% for item in items %}
      <tr>
        <td class="align-top w-6 min-w-6 pt-1">
          <input type="checkbox"
                 id="cb-select-{{ item.id }}"
                 class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                 name="selected_items[]"
                 value="{{ item.id }}"
                 {% if item.primary_email != blank or item.primary_phone != blank or item.cc_email != blank %}checked{% else %}disabled{% endif %}
          >
        </td>
        <td class="pb-2 pe-2">
          <label for="cb-select-{{ item.id }}" class="whitespace-nowrap max-w-[12rem] overflow-hidden text-ellipsis font-bold">{{ item.print.tokens.first_name }} {{ item.print.tokens.last_name }}</label>
          <div class="text-xs max-w-[15rem] text-gray-500 overflow-hidden text-ellipsis leading-3 mb-1">{{ item.print.tokens.position[0].organization_name }}</div>
        </td>
        <td class="whitespace-nowrap align-top max-w-[15rem] overflow-hidden text-ellipsis pe-2">
          {{ item.primary_email | default: "-"}}
        </td>
        <td class="align-top max-w-[15rem] overflow-hidden text-ellipsis">
          {{ item.cc_email | join: ", " }}
        </td>
        <td class="align-top max-w-[15rem] overflow-hidden text-ellipsis">
          {{ item.primary_phone | default: "-" }}
        </td>
        <td class="align-top">
          <a href="/admin/contacts/{{ item.id }}" target="_blank" class="text-blue-600 hover:underline">View</a>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <div>
    <button type="submit"
            class="my-4 inline-block transition duration-500 rounded-lg px-6 py-2 uppercase text-base leading-8 font-sans text-white bg-primary hover:bg-gray-900 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      Remove Guests
    </button>
  </div>
</form>
{% endif %}